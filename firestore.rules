rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidPortfolioItem(data) {
      return data.imageSrc is string && data.imageSrc.size() > 0;
    }

    match /portfolioItems/{itemId} {
      allow read: if true;
      allow create, update: if isValidPortfolioItem(request.resource.data);
      allow delete: if true;
    }

    match /appSettings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
